# Every environment variable your app needs, with harmless placeholders.
# Всички променливи на средата за приложението с примерни стойности (без истински тайни).

# Server port (default 3000) / Порт на сървъра (по подразбиране 3000)
PORT=3000

# Required: PostgreSQL connection string from Neon / Задължително: връзка към Neon PostgreSQL
DATABASE_URL=postgres://user:password@host/dbname

# Required: random session secret (generate with: openssl rand -hex 32) / Задължително: тайна за сесиите
SESSION_SECRET=change-me

# Base public URL of the app / Базов публичен адрес на приложението
PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth credentials (from Google Cloud Console) / Данни за Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI model settings (app still works without key via fallback) / Настройки за модела (има резервен вариант без ключ)
GEMINI_API_KEY=
MODEL_NAME=gemini-1.5-flash

# Optional token for MCP integration / Опционален токен за MCP интеграция
MCP_TOKEN=